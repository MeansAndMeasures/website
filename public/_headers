/*
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; frame-src 'self'; connect-src 'self'; script-src 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Link: </.well-known/api-catalog>; rel="api-catalog"

/kc/*
  ! Content-Security-Policy
  ! Referrer-Policy
  ! Link
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org; frame-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self'
  Referrer-Policy: no-referrer
  Link: </.well-known/api-catalog>; rel="api-catalog", </kc/services.json>; rel="service-desc", </kc/crisis.json>; rel="service-desc"

/es/kc/*
  ! Content-Security-Policy
  ! Referrer-Policy
  ! Link
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.tile.openstreetmap.org; frame-src 'self'; connect-src 'self'; script-src 'self' 'unsafe-inline'; worker-src 'self'
  Referrer-Policy: no-referrer
  Link: </.well-known/api-catalog>; rel="api-catalog", </kc/services.json>; rel="service-desc", </kc/crisis.json>; rel="service-desc"

/kc-sw.js
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
