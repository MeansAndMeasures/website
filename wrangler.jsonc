{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meansandmeasures-website",
	"compatibility_date": "2026-05-15",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "meansandmeasures.com", "custom_domain": true }, { "pattern": "www.meansandmeasures.com", "custom_domain": true }],
	"preview_urls": false,
	"send_email": [{
		"name": "INTAKE_EMAIL",
		"allowed_destination_addresses": ["contact@meansandmeasures.com", "procurement@meansandmeasures.com"]
	}],
	"d1_databases": [
		{
			"binding": "INTAKE_DB",
			"database_name": "meansandmeasures-intake",
			"database_id": "0a0d04a8-e4ec-4e70-818c-73a472506e3e",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
