{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "civicbrands-website",
	"compatibility_date": "2026-05-15",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "meansandmeasures.com", "custom_domain": true }, { "pattern": "www.meansandmeasures.com", "custom_domain": true }],
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "INTAKE_DB",
			"database_name": "civicbrands-intake",
			"database_id": "49b49947-10c8-45b4-a494-d37414ff4f88",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
