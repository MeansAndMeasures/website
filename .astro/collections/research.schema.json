{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "published": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived",
        "historical"
      ]
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authors": {
      "default": [
        "CivicBrands"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "agency": {
      "type": "string"
    },
    "docket": {
      "type": "string"
    },
    "submitted": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}