---
const year = new Date().getFullYear();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isKcSection = pathname === "/kc" || pathname.startsWith("/kc/") || pathname.startsWith("/es/kc");
---

<footer class="site-footer">
    <div class="site-footer__inner">
        <div class="site-footer__meta">
            <p>&copy; {year} Means+Measures</p>
            <p> <em>For the Commons</em> • EIN 39-2829761</p>
            <p><a href="tel:+18163063481">816-306-3481</a> · <a href="mailto:info@meansandmeasures.com">info@meansandmeasures.com</a></p>
        </div>

        <nav class="site-footer__nav" aria-label="Footer navigation">
            {isKcSection
                ? <a href="/kc/crisis" class="site-footer__needhelp">Need help now</a>
                : <a href="/kc">KC resources</a>}
            <a href="/systems">Systems</a>
            <a href="/updates">Updates</a>
            <a href="/status">Status</a>
            <a href="/sitemap">Site map</a>
            <a href="/brand">Brand</a>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/legal">Legal</a>
            <a href="/procurement">Procurement</a>
            <a href="/api/notary/session">Journal sign-in</a>
        </nav>
    </div>
</footer>
