---
const navItems = [
    { href: "/systems", label: "Systems" },
    { href: "/civicnavigator", label: "CivicNavigator" },
    { href: "/work", label: "Work" },
    { href: "/research", label: "Research" },
    { href: "/artifacts", label: "Artifacts" },
    { href: "/procurement", label: "Procurement" },
    { href: "/about", label: "About" },
    { href: "/contact", label: "Contact" },
    { href: "/account/", label: "Sign in" }
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isKcSection = pathname === "/kc" || pathname.startsWith("/kc/") || pathname.startsWith("/es/kc");
---

<header class="site-header" data-kc={isKcSection ? "true" : undefined}>
    <div class="site-header__inner">
        <a class="site-header__mark" href="/" aria-label="Means+Measures home">
            <img class="mm-logo" src="/means-measures/assets/means-measures-logo-symbol.png" alt="Means+Measures" width="1500" height="1500" />
        </a>

        <nav class="site-header__nav" aria-label="Primary navigation">
            {navItems.map((item) => {
                const isCurrent = pathname === item.href;

                return (
                    <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                        {item.label}
                    </a>
                );
            })}
            {!isKcSection && (
                <a href="/kc" class="site-header__kclink">KC</a>
            )}
            {isKcSection && (
                <>
                    <a href="/kc/crisis" class="site-header__needhelp">Need Help Now</a>
                    <button type="button" class="site-header__escape" aria-label="Leave this site quickly">
                        Leave site
                    </button>
                </>
            )}
        </nav>
    </div>
</header>

{isKcSection && (
    <script is:inline>
        (function () {
            const button = document.querySelector(".site-header__escape");
            if (!button) return;

            const escape = function () {
                // KC preferences share this origin with the notary journal.
                // Only remove KC-owned keys; journal identity and pending seals must survive.
                for (const name of ["sessionStorage", "localStorage"]) {
                    try {
                        const storage = window[name];
                        for (let index = storage.length - 1; index >= 0; index--) {
                            const key = storage.key(index);
                            if (key && key.startsWith("kc-")) storage.removeItem(key);
                        }
                    } catch (e) {
                        /* storage may be unavailable; continue leaving */
                    }
                }
                window.location.replace("https://www.google.com");
            };

            button.addEventListener("click", escape);

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && event.shiftKey) {
                    escape();
                }
            });
        })();
    </script>
)}
