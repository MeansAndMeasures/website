---
import SiteFinder from "./SiteFinder.astro";
import { headerTitleFor, isKcPath, navFor, normalizePath } from "../data/siteRoutes";

interface Props {
    // Overrides the route table, e.g. a detail page's own title.
    title?: string;
}

const pathname = normalizePath(Astro.url.pathname);
const isKcSection = isKcPath(pathname);
const title = Astro.props.title ?? headerTitleFor(pathname);
// The current page (or its section) is named beside the logo, not linked.
const navItems = navFor(pathname);
---

<header class="site-header" data-kc={isKcSection ? "true" : undefined}>
    <div class="site-header__inner">
        <div class="site-header__identity">
            <a class="site-header__mark" href="/" aria-label="Means+Measures home">
                <img class="mm-logo" src="/means-measures/assets/web/means-measures-symbol-192.png" alt="Means+Measures" width="192" height="192" />
            </a>
            <p class="site-header__title" aria-hidden={title ? undefined : "true"}>{title}</p>
        </div>

        <nav class="site-header__nav" aria-label="Primary navigation">
            {navItems.map((item) => (
                <a href={item.href}>{item.label}</a>
            ))}
            {!isKcSection && (
                <a href="/kc" class="site-header__kclink">KC</a>
            )}
            <button type="button" class="site-header__find" data-finder-open hidden aria-haspopup="dialog" aria-keyshortcuts="/">
                Find <kbd aria-hidden="true">/</kbd>
            </button>
            {isKcSection && (
                <>
                    <a href="/kc/crisis" class="site-header__needhelp">Need help now</a>
                    <button type="button" class="site-header__escape" aria-label="Leave this site quickly">
                        Leave site
                    </button>
                </>
            )}
        </nav>
    </div>
</header>

<dialog class="finder-dialog" data-finder-dialog aria-label="Find a page">
    <div class="finder-dialog__inner">
        <SiteFinder id="site-finder" variant="dialog" />
        <button type="button" class="finder-dialog__close" data-finder-close>Close</button>
    </div>
</dialog>
<script is:inline type="module" src="/lib/finder.js"></script>

{isKcSection && (
    <script is:inline>
        (function () {
            const button = document.querySelector(".site-header__escape");
            if (!button) return;

            const escape = function () {
                // KC preferences share this origin with the notary journal.
                // Only remove KC-owned keys; journal identity and pending seals must survive.
                for (const name of ["sessionStorage", "localStorage"]) {
                    try {
                        const storage = window[name];
                        for (let index = storage.length - 1; index >= 0; index--) {
                            const key = storage.key(index);
                            if (key && key.startsWith("kc-")) storage.removeItem(key);
                        }
                    } catch (e) {
                        /* storage may be unavailable; continue leaving */
                    }
                }
                window.location.replace("https://www.google.com");
            };

            button.addEventListener("click", escape);

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && event.shiftKey) {
                    escape();
                }
            });
        })();
    </script>
)}
