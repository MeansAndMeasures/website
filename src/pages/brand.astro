---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
        title="Brand Authority — Means+Measures"
        description="Means+Measures brand reference, visual identity, citation guidance, and journalist-facing source material."
>
    <section class="section">
        <p class="eyebrow">Brand Authority</p>

        <div class="measure">
            <h1>Brand Authority</h1>

            <p>
                This page preserves the Means+Measures visual identity reference as an official public source for journalists, partners, procurement reviewers, and anyone referencing the organization.
            </p>

            <p>
                Use <strong>Means+Measures</strong> as the public name. The historical CivicBrands DBA record identifies BJL13 Enterprise Solutions LLC.
            </p>

            <p class="document-action">
                <a href="/means-measures/index.html">Open the current Means+Measures identity reference</a>
            </p>
        </div>
    </section>

    <section class="section section--compact">
        <div class="measure">
            <h2>Reference Assets</h2>

            <ul class="asset-list">
                <li><a href="/means-measures/assets/means-measures-logo-wordmark.png">Horizontal header lockup</a></li>
            </ul>
        </div>
    </section>

    <section class="brand-document" aria-label="Embedded Means+Measures brand specification">
        <iframe
                src="/means-measures/index.html"
                title="Means+Measures brand specification"
                loading="lazy"
        ></iframe>
    </section>
<section class="section section--compact"><div class="measure"><h2>Historical identity</h2><p><a href="/brand/civicbrands-brand-spec.html">Archived CivicBrands brand specification</a></p></div></section>
</BaseLayout>
