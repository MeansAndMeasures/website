---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
        title="Brand Authority — CivicBrands"
        description="CivicBrands brand reference, visual identity, citation guidance, and journalist-facing source material."
>
    <section class="section">
        <p class="eyebrow">Brand Authority</p>

        <div class="measure">
            <h1>Brand Authority</h1>

            <p>
                This page preserves the CivicBrands visual identity reference as an official public source for journalists, partners, procurement reviewers, and anyone referencing the organization.
            </p>

            <p>
                Use <strong>CivicBrands</strong> as the public name. CivicBrands is a DBA of BJL13 Enterprise Solutions LLC.
            </p>

            <p class="document-action">
                <a href="/brand/civicbrands-brand-spec.html">Open the original brand specification</a>
            </p>
        </div>
    </section>

    <section class="section section--compact">
        <div class="measure">
            <h2>Reference Assets</h2>

            <ul class="asset-list">
                <li><a href="/brand/assets/header.svg">Horizontal header lockup</a></li>
                <li><a href="/brand/assets/logo-mark.svg">Logo mark</a></li>
                <li><a href="/brand/assets/monogram.svg">Monogram</a></li>
                <li><a href="/brand/assets/favicon.svg">Favicon</a></li>
            </ul>
        </div>
    </section>

    <section class="brand-document" aria-label="Embedded CivicBrands brand specification">
        <iframe
                src="/brand/civicbrands-brand-spec.html"
                title="CivicBrands brand specification"
                loading="lazy"
        ></iframe>
    </section>
</BaseLayout>
