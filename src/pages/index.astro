---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFinder from "../components/SiteFinder.astro";

const services = await getCollection("kcServices");

// Standing work, stated as facts that can be checked on the page each links to.
const standing = [
    {
        href: "/civicnavigator",
        name: "CivicNavigator",
        fact: "Help with the letter, the form, and the next step, in the hands of the person holding the paperwork.",
        state: "in development"
    },
    {
        href: "https://forecast.meansandmeasures.com",
        name: "Forecast",
        fact: "Environmental and civic observations kept attached to their sources, at full resolution in time and place.",
        state: "live"
    },
    {
        href: "/work/open-cognition",
        name: "Open Cognition",
        fact: "Governed memory for AI agents: immutable records, scoped references, and state changes that name who made them.",
        state: "published"
    },
    {
        href: "/kc",
        name: "Kansas City Metro Resource Directory",
        fact: `${services.length} services across nine counties and two states, in English and Spanish, with open exports anyone may mirror.`,
        state: "live"
    },
    {
        href: "/artifacts",
        name: "Public record",
        fact: "Federal public comments on USCIS biometrics and NWK-408, and the Record Sufficiency Matrix, published so they can be checked without asking us.",
        state: "published"
    }
];
---

<BaseLayout
    title="Means+Measures. Equity of means. Equality of measures."
    description="Equity of means: lack of privilege is not lack of access. Equality of measures: impacts are judged on their own merits, not the standing of those responsible."
>
    <section class="home-name" aria-labelledby="homepage-title">
        <div class="home-name__figure">
            <h1 id="homepage-title" class="home-name__logotype"><span class="home-name__word">Means<span class="home-name__plus">+</span></span><span class="home-name__word">Measures</span></h1>

            <hr class="gold-bar home-name__bar" />

            <div class="home-pair__side">
                <p class="home-pair__head">Equity of means.</p>
                <p class="home-pair__clause">That lack of privilege is not lack of access.</p>
            </div>

            <div class="home-pair__side">
                <p class="home-pair__head">Equality of measures.</p>
                <p class="home-pair__clause">That impacts are judged on their own merits, not the standing of those responsible.</p>
            </div>
        </div>

        <div class="home-name__finder">
            <SiteFinder id="home-finder" variant="inline" />
        </div>

        <div class="home-thesis">
            <h2 class="home-thesis__title">Down through systems. Up through people.</h2>

            <div class="home-thesis__side home-thesis__side--down">
                <span class="home-thesis__rule" aria-hidden="true"></span>
                <p>Institutions bear responsibility down through systems for making the means of participation accessible.</p>
            </div>

            <div class="home-thesis__side home-thesis__side--up">
                <span class="home-thesis__rule" aria-hidden="true"></span>
                <p>Authority rises up through people who question, evaluate, and hold those institutions accountable.</p>
            </div>
        </div>
    </section>

    <section class="home-standing" aria-labelledby="home-standing-title">
        <p id="home-standing-title" class="eyebrow">Standing work</p>

        <ul class="home-ledger">
            {standing.map((item) => (
                <li>
                    <a class="home-ledger__row" href={item.href}>
                        <span class="home-ledger__name">{item.name}</span>
                        <span class="home-ledger__fact">{item.fact}</span>
                        <span class="home-ledger__state">{item.state}</span>
                    </a>
                </li>
            ))}
        </ul>

        <div class="measure home-standing__close">
            <p>
                We stand with the people already doing the work, never as agents of replacement and never favoring a system over the people who comprise it.
            </p>
            <p class="home-standing__links">
                <a href="/about">About Means+Measures</a>
                <a href="/contact">Contact</a>
            </p>
        </div>
    </section>
</BaseLayout>
