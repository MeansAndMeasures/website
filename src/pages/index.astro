---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
		title="CivicBrands"
		description="CivicBrands builds responsibility upwards through systems and engagement upwards from the people served."
>
	<section class="section homepage-hero" aria-labelledby="homepage-title">
		<div class="homepage-hero__kicker">
			<p class="eyebrow">Down through systems. Up through people.</p>
		</div>

		<h1 id="homepage-title" class="hero-title">Civic ◆ Brands</h1>

		<div class="measure homepage-hero__summary">
			<p>
				CivicBrands builds responsibility upwards to those in place and lifts engagement from those served. We stand with the people already doing the work, never as agents of replacement and never favoring a system over the people who comprise it.
			</p>
		</div>
	</section>

	<section class="section section--routing" aria-labelledby="homepage-routing-title">
		<p id="homepage-routing-title" class="eyebrow">Index</p>

		<div class="grid homepage-routing">
			<a class="route-panel" href="/systems">
				<p class="eyebrow">Systems</p>
				<h2 class="card-title">The public infrastructure set</h2>
			</a>

			<a class="route-panel" href="/capabilities">
				<p class="eyebrow">Capabilities</p>
				<h2 class="card-title">What CivicBrands can build</h2>
			</a>

			<a class="route-panel" href="/work">
				<p class="eyebrow">Work</p>
				<h2 class="card-title">Representative work</h2>
			</a>

			<a class="route-panel" href="/research">
				<p class="eyebrow">Research</p>
				<h2 class="card-title">Analysis and writing</h2>
			</a>

			<a class="route-panel" href="/artifacts">
				<p class="eyebrow">Artifacts</p>
				<h2 class="card-title">Documents and records</h2>
			</a>

			<a class="route-panel" href="/procurement">
				<p class="eyebrow">Procurement</p>
				<h2 class="card-title">Entity information</h2>
			</a>

			<a class="route-panel" href="/about">
				<p class="eyebrow">About</p>
				<h2 class="card-title">Organization</h2>
			</a>

			<a class="route-panel" href="/contact">
				<p class="eyebrow">Contact</p>
				<h2 class="card-title">Get in touch</h2>
			</a>

			<a class="route-panel" href="/kc">
				<p class="eyebrow">Kansas City</p>
				<h2 class="card-title">Metro directory</h2>
			</a>

			<a class="route-panel" href="https://forecast.civicbrands.org">
				<p class="eyebrow">Forecast</p>
				<h2 class="card-title">Observational field infrastructure</h2>
			</a>

			<a class="route-panel" href="/updates">
				<p class="eyebrow">Updates</p>
				<h2 class="card-title">What changed recently</h2>
			</a>

			<a class="route-panel" href="/status">
				<p class="eyebrow">Status</p>
				<h2 class="card-title">Operational posture</h2>
			</a>
		</div>
	</section>
</BaseLayout>
