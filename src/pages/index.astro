---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const services = await getCollection("kcServices");

// The page is an argument, not an index. Each section makes one claim in the
// organization's own words, shows what backs it, and offers one way deeper.
const claims = [
    {
        id: "means",
        label: "Equity of means",
        claim: "Lack of privilege is not lack of access.",
        evidence: [
            "CivicNavigator, in development, puts help with the letter, the form, and the next step in the hands of the person holding the paperwork.",
            `The Kansas City Metro Resource Directory covers ${services.length} services across nine counties and two states, in English and Spanish, and says before you go whether you will need ID, insurance, or an appointment.`
        ],
        exit: { href: "/systems", label: "See the systems" }
    },
    {
        id: "measures",
        label: "Equality of measures",
        claim: "Impacts are judged on their own merits, not the standing of those responsible.",
        evidence: [
            "The Record Sufficiency Matrix asks one thing of any system: does it keep enough record for a consequential action to be understood and reviewed?",
            "Our federal comments on USCIS biometrics and NWK-408 are published whole, so they can be checked without asking us. Forecast keeps every observation attached to where and when it came from."
        ],
        exit: { href: "/artifacts", label: "Read the record" }
    },
    {
        id: "down",
        label: "Down through systems",
        direction: "down",
        claim: "Institutions bear responsibility down through systems for making the means of participation accessible.",
        evidence: [
            "We work with public institutions and civic organizations on the parts that carry that responsibility: information people can find and use, records that hold up to review, and AI governance that names who reviews, who decides, and what stops the machine."
        ],
        exit: { href: "/capabilities", label: "What we can build" }
    },
    {
        id: "up",
        label: "Up through people",
        direction: "up",
        claim: "Authority rises up through people who question, evaluate, and hold those institutions accountable.",
        evidence: [
            "So the work ships where people can get at it. Directory data is free to mirror and anyone can correct a listing. Methods, sources, and limits are stated, so the people affected can test a claim themselves."
        ],
        exit: { href: "/work", label: "See the work" }
    }
];
---

<BaseLayout
    title="Means+Measures. Equity of means. Equality of measures."
    description="Means+Measures builds infrastructure, data systems, and analysis that treat equity as the first requirement. Equity of means. Equality of measures."
>
    <section class="home-name" aria-labelledby="homepage-title">
        <div class="home-name__figure">
            <h1 id="homepage-title" class="home-name__logotype"><span class="home-name__word">Means<span class="home-name__plus">+</span></span><span class="home-name__word">Measures</span></h1>

            <hr class="gold-bar home-name__bar" />

            <p class="home-pair__head">Equity of means.</p>
            <p class="home-pair__head">Equality of measures.</p>
        </div>

        <div class="home-name__lede">
            <p>
                Means+Measures builds infrastructure, data systems, and analysis that treat equity as the first requirement.
            </p>
            <p class="home-actions">
                <a class="mm-action mm-type-action home-action" href="/systems">See the work</a>
                <a class="home-actions__second" href="/contact">Get in touch</a>
            </p>
        </div>
    </section>

    {claims.map((item) => (
        <section class="home-claim" aria-labelledby={`claim-${item.id}`} data-direction={item.direction}>
            <div class="home-claim__head">
                <p class="eyebrow">{item.label}</p>
                {item.direction && <span class="home-claim__rule" aria-hidden="true"></span>}
            </div>

            <div class="home-claim__body">
                <h2 id={`claim-${item.id}`} class="home-claim__title">{item.claim}</h2>
                {item.evidence.map((line) => <p>{line}</p>)}
                <p class="home-claim__exit"><a href={item.exit.href}>{item.exit.label}</a></p>
            </div>
        </section>
    ))}

    <section class="home-close">
        <p>
            We stand with the people already doing the work, never as agents of replacement and never favoring a system over the people who comprise it.
        </p>
        <p class="home-actions">
            <a class="mm-action mm-type-action home-action" href="/contact">Get in touch</a>
            <a class="home-actions__second" href="/procurement">Procurement and entity facts</a>
        </p>
    </section>
</BaseLayout>
