---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFinder from "../components/SiteFinder.astro";

---

<BaseLayout
    title="Means+Measures. Equity of means. Equality of measures."
    description="Equity of means: lack of privilege is not lack of access. Equality of measures: impacts are judged on their own merits, not the standing of those responsible."
>
    <section class="home-name" aria-labelledby="homepage-title">
        <div class="home-name__figure">
            <h1 id="homepage-title" class="home-name__logotype"><span class="home-name__word">Means<span class="home-name__plus">+</span></span><span class="home-name__word">Measures</span></h1>

            <hr class="gold-bar home-name__bar" />

            <div class="home-pair__side">
                <p class="home-pair__head">Equity of means.</p>
                <p class="home-pair__clause">That lack of privilege is not lack of access.</p>
            </div>

            <div class="home-pair__side">
                <p class="home-pair__head">Equality of measures.</p>
                <p class="home-pair__clause">That impacts are judged on their own merits, not the standing of those responsible.</p>
            </div>
        </div>

        <div class="home-name__finder">
            <SiteFinder id="home-finder" variant="inline" />
        </div>

        <div class="home-thesis">
            <h2 class="home-thesis__title">Down through systems. Up through people.</h2>

            <div class="home-thesis__side home-thesis__side--down">
                <span class="home-thesis__rule" aria-hidden="true"></span>
                <p>Institutions bear responsibility down through systems for making the means of participation accessible.</p>
            </div>

            <div class="home-thesis__side home-thesis__side--up">
                <span class="home-thesis__rule" aria-hidden="true"></span>
                <p>Authority rises up through people who question, evaluate, and hold those institutions accountable.</p>
            </div>
        </div>
    </section>

    <section class="home-close">
        <p>
            We stand with the people already doing the work, never as agents of replacement and never favoring a system over the people who comprise it.
        </p>
    </section>
</BaseLayout>
