---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
        title="Means+Measures"
        description="Means+Measures builds responsibility upwards through systems and engagement upwards from the people served."
>
    <section class="section">
        <p class="eyebrow">Means+Measures</p>

        <h1 class="hero-title">
            Down through systems. Up through people.
        </h1>

        <div class="measure">
            <p>
                Means+Measures continues the work previously published as CivicBrands by BJL13 Enterprise Solutions LLC. The work is editorial, infrastructural, and document-forward: making systems legible enough that responsibility, consequence, and agency remain attached to the people inside them.
            </p>

            <p>
                We stand with the people already doing the work. Means+Measures does not frame institutional repair as replacement or disruption for its own sake. It names what is broken without theatre and builds structures that let accountability travel upward.
            </p>
        </div>
    </section>

    <section class="section section--compact">
        <div class="grid">
            <a href="/work">
                <h2 class="card-title">Work</h2>
                <p>Representative infrastructural and analytical work.</p>
            </a>

            <a href="/research">
                <h2 class="card-title">Research</h2>
                <p>Analysis and writing.</p>
            </a>

            <a href="/procurement">
                <h2 class="card-title">Procurement</h2>
                <p>Entity information and engagement readiness.</p>
            </a>

            <a href="/contact">
                <h2 class="card-title">Contact</h2>
                <p>Direct inquiry and coordination pathway.</p>
            </a>
        </div>
    </section>
</BaseLayout>
