---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
        title="Procurement — CivicBrands"
        description="Procurement and entity information for CivicBrands."
>
    <section class="section">
        <p class="eyebrow">Procurement</p>

        <div class="measure">
            <h1>Entity information and readiness.</h1>

            <p>
                CivicBrands maintains procurement-facing records for institutional review, vendor intake,
                public-sector coordination, and civic infrastructure work. The public facts are here so
                reviewers do not have to infer them from scattered pages.
            </p>

            <dl class="entry-meta">
                <dt>Organization</dt>
                <dd>CivicBrands</dd>

                <dt>Legal Entity</dt>
                <dd>BJL13 Enterprise Solutions LLC</dd>

                <dt>DBA</dt>
                <dd>CivicBrands</dd>

                <dt>EIN</dt>
                <dd>39-2829761</dd>

                <dt>Entity Type</dt>
                <dd>Missouri limited liability company using CivicBrands as public DBA</dd>

                <dt>Operating Base</dt>
                <dd>Kansas City, Missouri</dd>

                <dt>Publication Surface</dt>
                <dd>Static-first website for work, research, records, public data, and procurement materials.</dd>

                <dt>Primary Domains</dt>
                <dd>Civic infrastructure, public information systems, AI governance, workflow legibility, records, and document-forward analysis.</dd>

                <dt>Procurement Contact</dt>
                <dd><a href="mailto:procurement@mail.civicbrands.org">procurement@mail.civicbrands.org</a></dd>

                <dt>Phone</dt>
                <dd><a href="tel:+18163063481">816-306-3481</a></dd>
            </dl>
        </div>
    </section>

    <section class="section section--compact">
        <div class="capability-list">
            <section>
                <h2>Capability areas</h2>
                <ul>
                    <li>Civic information directories and public-resource infrastructure</li>
                    <li>Public data publishing, schema design, and machine-readable exports</li>
                    <li>Record-sufficiency review, public comment, and artifact preparation</li>
                    <li>AI governance, provenance, agent memory, and institutional workflow legibility</li>
                    <li>Plain-language, accessibility-forward forms and process guidance</li>
                </ul>
            </section>

            <section>
                <h2>Public materials</h2>
                <ul>
                    <li><a href="/artifacts/entity-records">Entity records</a></li>
                    <li><a href="/capabilities">Capabilities</a></li>
                    <li><a href="/systems">Systems overview</a></li>
                    <li><a href="/work">Representative work</a></li>
                    <li><a href="/brand">Brand authority and reference assets</a></li>
                </ul>
            </section>

            <section>
                <h2>Engagement posture</h2>
                <p>
                    CivicBrands is best suited for work where the public record matters, affected people
                    need clearer routes through a system, or an institution needs enough structure to be
                    accountable without burying people in process.
                </p>
            </section>

            <section>
                <h2>Not a fit for</h2>
                <p>
                    Surveillance, predictive policing, discriminatory screening, dark-pattern intake,
                    speculative data resale, or systems that make vulnerable people easier to punish.
                </p>
            </section>
        </div>
    </section>
</BaseLayout>
