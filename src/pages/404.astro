---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFinder from "../components/SiteFinder.astro";
---

<BaseLayout
        title="Not found — Means+Measures"
        description="The page at this address does not exist or is no longer published here."
        robots="noindex,follow"
>
    <section class="section" aria-labelledby="error-title">
        <p class="eyebrow">HTTP 404</p>

        <div class="measure">
            <h1 id="error-title">Not found.</h1>
            <p>
                Nothing is published at this address. It may have moved, or the link may be wrong.
                Say what you were looking for and the finder will route you.
            </p>
        </div>

        <div class="error-finder">
            <SiteFinder id="error-finder" variant="inline" label="What were you looking for?" />
        </div>

        <div class="measure">
            <p class="document-action">
                If a link on this site sent you here, that is ours to fix:
                <a href="/contact">tell us</a>. The <a href="/sitemap">site map</a> lists every public page.
            </p>
            <p class="error-machine">
                Automated clients: verify the requested URI and consult the discovery resources under
                <a href="/.well-known/api-catalog">/.well-known/api-catalog</a>.
            </p>
        </div>
    </section>
</BaseLayout>
