---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { authorizedIdentity } from "../../lib/websiteAuth";
import { GET as intake } from "../api/intake/export";
import { GET as suggestions } from "../api/kc-suggest/export";
export const prerender = false;
const tool = Astro.params.tool;
if (tool !== "intake" && tool !== "suggestions") return new Response("Not found", { status: 404 });
const identity = await authorizedIdentity(Astro.request, tool);
Astro.response.headers.set("Cache-Control", "no-store");
if (!identity) return new Response("Sign in is required.", { status: 401, headers: { "cache-control": "no-store" } });
const response = await (tool === "intake" ? intake : suggestions)(Astro);
const body = await response.json();
const submissions = body.submissions ?? [];
Astro.response.status = response.status;
const title = tool === "intake" ? "Contact intake" : "KC suggestions";
---
<BaseLayout title={`${title} — Means+Measures`} robots="noindex, nofollow">
    <section class="section">
        <p><a href="/account/">← Your workspace</a></p>
        <h1>{title}</h1>
        {!response.ok && <p role="alert">{body.error ?? "Submissions could not be loaded."}</p>}
        {response.ok && submissions.length === 0 && <p>No submissions yet.</p>}
        {submissions.map((item: Record<string, unknown>) => (
            <article class="submission">
                <h2>{String(item.topic ?? item.orgName ?? item.type ?? "Submission")}</h2>
                <dl>{Object.entries(item).filter(([key, value]) => value !== null && value !== "" && !["userAgent", "remoteAddress"].includes(key)).map(([key, value]) => (
                    <div><dt>{({ submittedAt: "Received", emailStatus: "Email delivery", orgName: "Organization", submitterName: "Submitted by", submitterContact: "Contact", translationContribution: "Translation contribution", emailMessageId: "Email receipt", emailSentAt: "Email sent" } as Record<string, string>)[key] ?? key.charAt(0).toUpperCase() + key.slice(1)}</dt><dd>{String(value)}</dd></div>
                ))}</dl>
            </article>
        ))}
    </section>
</BaseLayout>
<style>
.submission { padding: 1.5rem 0; border-bottom: 1px solid #aaa; }
dl > div { display: grid; grid-template-columns: minmax(7rem, 1fr) 3fr; gap: 1rem; margin: .65rem 0; }
dt { font-weight: 600; } dd { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
@media (max-width: 35rem) { dl > div { grid-template-columns: 1fr; gap: .25rem; } }
</style>
