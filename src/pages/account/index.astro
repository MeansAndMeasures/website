---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { authorizedIdentity } from "../../lib/websiteAuth";
export const prerender = false;
const identity = await authorizedIdentity(Astro.request, "connections");
Astro.response.headers.set("Cache-Control", "no-store");
if (!identity) return new Response("Sign in is required.", { status: 401, headers: { "cache-control": "no-store" } });
---
<BaseLayout title="Your workspace — Means+Measures" description="Your private Means+Measures workspace." robots="noindex, nofollow">
    <section class="section">
        <p class="eyebrow">Your workspace</p>
        <h1>Means+Measures</h1>
        <p>Signed in as {identity.email}.</p>
        <div class="workspace-tools">
            <a class="workspace-tool" href="/notary/"><h2>Notary journal</h2><p>Open your journal and synchronize encrypted records.</p></a>
            <a class="workspace-tool" href="/account/intake/"><h2>Contact intake</h2><p>Read submissions and check email delivery.</p></a>
            <a class="workspace-tool" href="/account/suggestions/"><h2>KC suggestions</h2><p>Review submitted resources and corrections.</p></a>
        </div>
        <p><a href="/cdn-cgi/access/logout">Sign out</a></p>
    </section>
</BaseLayout>
<style>
.workspace-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; margin: 2rem 0; }
.workspace-tool { display: block; padding: 1.5rem; border: 1px solid currentColor; border-radius: .4rem; color: inherit; text-decoration: none; }
.workspace-tool:hover, .workspace-tool:focus-visible { background: #f2eee4; }
.workspace-tool h2 { margin-top: 0; }
</style>
