---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import KCReadabilityControls from "../components/KCReadabilityControls.astro";
import KCSubnav from "../components/KCSubnav.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    robots?: string;
    noReferrer?: boolean;
    showSubnav?: boolean;
    bodyClass?: string;
    lang?: "en" | "es";
}

const {
    title = "Kansas City — Means+Measures",
    description = "A people-first directory of survival, support, and navigation resources for the Kansas City metro.",
    image = "/means-measures/assets/means-measures-logo-wordmark.png",
    robots,
    noReferrer = false,
    showSubnav = true,
    bodyClass = "",
    lang = "en"
} = Astro.props;

const canonical = new URL(Astro.url.pathname, "https://meansandmeasures.com").toString();
const imageUrl = new URL(image, "https://meansandmeasures.com").toString();
---

<!doctype html>
<html lang={lang} class="mm">
<head>
    <link rel="stylesheet" href="/means-measures/means-measures.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/means-measures/assets/means-measures-logo-wordmark.png" />
    <meta property="og:site_name" content="Means+Measures" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
</head>

<body class={bodyClass}>
<a class="skip-link" href="#main-content">Skip to main content</a>
<SiteHeader />
<main id="main-content" class="kc" tabindex="-1">
    <KCReadabilityControls />
    {showSubnav && <KCSubnav />}
    <slot />
</main>
<SiteFooter />

<script is:inline>
    (function () {
        if (!("serviceWorker" in navigator)) return;
        if (window.location.hostname === "localhost") return;
        navigator.serviceWorker.register("/kc-sw.js").catch(function () { /* ignore */ });
    })();
</script>
</body>
</html>
